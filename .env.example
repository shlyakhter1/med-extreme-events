# Copy to .env (gitignored). Loaded automatically by every `make` target via `uv run --env-file`.

# VA Lighthouse Facilities API key — free at https://developer.va.gov/apply; sent as `apikey` header
VA_FACILITIES_API_KEY=

# AirNow API key — free at https://docs.airnowapi.org/account/request/
AIRNOW_API_KEY=

# NWS requires a contact string (no alerts without it); the public repository serves as the contact
NWS_USER_AGENT="med-extreme-events demo (https://github.com/shlyakhter1/med-extreme-events)"

# Optional: HUD USPS ZIP-county crosswalk token (else the Census ZCTA fallback is used)
HUD_API_TOKEN=

# EAGLE-I county outages (live mode). FEMA's partner FeatureServer requires an ArcGIS token
# (verified 2026-09-21); leave EAGLEI_TOKEN empty and set EAGLEI_FEATURE_URL to a public
# EAGLE-I mirror layer with the same fields (e.g. a state EMA's) to run without one.
EAGLEI_TOKEN=
# Public mirrors (Georgia GEMA, Ohio), space-separated — the same default as render.yaml / Dockerfile
EAGLEI_FEATURE_URL="https://services1.arcgis.com/2iUE8l8JKrP2tygQ/arcgis/rest/services/Join_Features_to_GEMA_All_Hazards_and_Master_Contacts_Layer_view/FeatureServer/0 https://services6.arcgis.com/zxOMWqh0yAD6mMsJ/arcgis/rest/services/power_outages_eagle_i/FeatureServer/0"

# replay | live
EVENT_MODE=replay

# Minutes between automatic live refreshes inside the web app (0/empty = off). The Docker
# image defaults to 60 so a rebuilt container or a woken Render instance repopulates live events.
LIVE_REFRESH_MINUTES=60

# SQLite fallback (zero install). For Postgres+PostGIS run `make db-up` and use:
#   DATABASE_URL=postgresql+psycopg://xevents:xevents@localhost:5432/xevents
DATABASE_URL=sqlite:///xevents.db
